# 1) Required core connectivity

# Runtime database URL used by application code and Alembic migrations.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# Default in code: none (required)
# Example: postgresql+psycopg://postgres:password@localhost:5432/media_manager
DATABASE_URL=

# API bind host for the packaged FastAPI launcher.
# Default in code: 127.0.0.1
# Example: 127.0.0.1
MEDIA_MANAGER_API_HOST=127.0.0.1

# API bind port for the packaged FastAPI launcher.
# Default in code: 8000
# Example: 8000
MEDIA_MANAGER_API_PORT=8000

# Reload flag for the packaged FastAPI launcher.
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Example: false
MEDIA_MANAGER_API_RELOAD=false

# 6) Test/tooling variables

# Test database URL used by pytest fixtures and Phase 10.1 audit tooling.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# Default in code: none (required for tests)
# Example: postgresql+psycopg://postgres:password@localhost:5432/media_manager_test
# Precedence note: tools may fall back to DATABASE_URL when unset.
TEST_DATABASE_URL=

# 2) Logging and metadata behavior

# Application log level.
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default in code: INFO
# Example: INFO
LOG_LEVEL=INFO

# Required metadata codes for planner strictness checks (comma-separated).
# Format: CSV of uppercase metadata code types.
# Default in code: OWNER,CONTEXT,TAKEN_DT
# Example: OWNER,CONTEXT,TAKEN_DT
MEDIA_REQUIRED_CODES=OWNER,CONTEXT,TAKEN_DT

# Canonical storage root for planned canonical file destinations.
# Format: absolute directory path; must be writable by the runtime or a writable parent must already exist.
# Default in code: none (required)
# Example: /srv/media-library
MEDIA_CANONICAL_STORAGE_PATH=

# Duplicate storage root for planned duplicate file destinations.
# Format: absolute directory path; must be writable by the runtime or a writable parent must already exist.
# Default in code: none (required)
# Example: /srv/media-library/Duplicates
MEDIA_DUPLICATE_STORAGE_PATH=

# Tag normalization toggle for punctuation stripping.
# Allowed truthy values: 1, true, yes, on
# Default in code: 0 (disabled)
# Example: 0
MEDIA_MANAGER_TAG_NORMALIZATION_REMOVE_PUNCTUATION=0

# 3) Canonical policy defaults

# Default canonical selection policy used before operator override persistence exists.
# Allowed: FIRST_SEEN, PREFER_ROOT, SHORTEST_PATH
# Default in code: FIRST_SEEN
# Example: FIRST_SEEN
MEDIA_CANONICAL_POLICY=FIRST_SEEN

# Preferred roots for PREFER_ROOT policy tie-breaking (comma-separated).
# Format: CSV absolute root paths, e.g. /Archive,/Media
# Default in code: empty
# Example: /Archive,/Media
MEDIA_PREFERRED_ROOTS=

# 4) Observability and performance tuning

# Prometheus metrics enable flag.
# Allowed truthy values: 1, true, yes, on
# Default in code: 0 (disabled)
# Example: 0
MEDIA_MANAGER_METRICS_ENABLED=0

# Port for standalone Prometheus HTTP metrics server when enabled.
# Format: integer port
# Default in code: 9000
# Example: 9000
MEDIA_MANAGER_METRICS_PORT=9000

# Optional operator-facing Prometheus URL for Admin observability links.
# Default in code: empty
# Example: http://127.0.0.1:9090
MEDIA_MANAGER_PROMETHEUS_URL=

# Optional operator-facing Grafana URL for Admin observability links.
# Default in code: empty
# Example: http://127.0.0.1:3000
MEDIA_MANAGER_GRAFANA_URL=

# Canonical metadata read TTL cache toggle (optimization-only).
# Allowed truthy values: 1, true, yes, on
# Default in code: false (disabled)
# Example: false
CANONICAL_READ_CACHE_ENABLED=false

# Canonical metadata read TTL cache expiration in seconds.
# Format: positive float/integer
# Default in code: 30
# Example: 30
CANONICAL_READ_CACHE_TTL_SECONDS=30

# Planner metadata upsert batch size performance knob.
# Format: integer; runtime clamps to [1, 50000]
# Default in code: 1000
# Example: 1000
METADATA_UPSERT_BATCH_SIZE=1000

# Experimental planner MV reads toggle (safety-sensitive; disabled by default).
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Safety note: enabling allows planner callers to read eventually-consistent MV data.
# Example: false
MEDIA_MANAGER_ALLOW_PLANNER_MV_READS=false

# Optional local/server-side directory picker for the Pipeline Wizard Browse button.
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Local-use note: this browses directories on the server host, not the operator's workstation browser.
# Safety note: keep disabled outside trusted/local environments unless the allowed roots are tightly controlled.
# Example: false
MEDIA_MANAGER_DIRECTORY_PICKER_ENABLED=false

# Comma-separated absolute directory roots exposed to the optional Pipeline Wizard Browse button.
# Format: comma-separated absolute directory paths
# Default in code: empty
# Local-use note: these paths must exist on the same machine/container where the API server runs.
# Example: /srv/media/incoming,/srv/media/archive
MEDIA_MANAGER_DIRECTORY_PICKER_ROOTS=

# Optional server-local video poster generation for Gallery video cards.
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Local-use note: thumbnails are generated on the API server host and require ffmpeg on that host.
# Example: false
MEDIA_MANAGER_VIDEO_THUMBNAILS_ENABLED=false

# Optional cache directory for generated video thumbnails.
# Format: absolute or user-home-relative directory path
# Default in code: system temp cache under media-manager/video-thumbnails
# Local-use note: this directory lives on the API server host and is optimization-only.
# Example: /tmp/media-manager/video-thumbnails
MEDIA_MANAGER_VIDEO_THUMBNAIL_CACHE_DIR=

# Optional default integrity scan mode used by import-triggered integrity scans.
# Allowed: FAST, DEEP
# Default in code: FAST
# Example: FAST
MEDIA_MANAGER_IMPORT_INTEGRITY_SCAN_MODE=FAST

# Integrity quarantine root used when integrity workflows isolate files.
# Format: absolute directory path
# Default in code: /tmp/media-manager/quarantine
# Example: /srv/media-manager/quarantine
MEDIA_MANAGER_QUARANTINE_ROOT=/tmp/media-manager/quarantine

# Integrity quarantine retention window in days.
# Format: positive integer days
# Default in code: 14
# Example: 14
MEDIA_MANAGER_QUARANTINE_RETENTION_DAYS=14

# Duplicate holding-area root used by the duplicates-page move flow.
# Format: absolute directory path
# Default in code: /tmp/media-manager/reclaim
# Stage note: this is the configured holding area for duplicate extra copies moved from the Duplicates page.
# Example: /srv/media-manager/reclaim
MEDIA_MANAGER_RECLAIM_ROOT=/tmp/media-manager/reclaim

# Later recycle-bin root used by the separate recycle/purge workflow after holding-area retention expires.
# Format: absolute directory path
# Default in code: /tmp/media-manager/recycle-bin
# Stage note: this does not change the initial duplicate move target shown on the Duplicates page.
# Example: /srv/media-manager/recycle-bin
MEDIA_MANAGER_RECYCLE_BIN_ROOT=/tmp/media-manager/recycle-bin

# Later recycle purge window used after files enter the recycle-bin stage.
# Format: positive integer days
# Default in code: 30
# Stage note: this applies to the later recycle/purge workflow, not the initial duplicate holding window shown on the Duplicates page.
# Example: 30
MEDIA_MANAGER_RECYCLE_PURGE_DAYS=30

# Note: the duplicate holding retention shown on the Duplicates page is policy-backed, not env-backed.
# Default in code: duplicate_reclaim_default_retention_days=14 in policy defaults, until changed through policy settings.

# 5) Admin safety controls

# Environment gate for destructive admin reset operations.
# Allowed for reset: dev, test
# Default in code: empty (reset forbidden)
# Safety note: must be dev or test to allow db-reset.
# Example: dev
MEDIA_MANAGER_ENV=dev

# Challenge word required for non-dry-run database reset.
# Default in code: media-manager
# Safety note: change in shared environments to reduce accidental resets.
# Example: media-manager
MEDIA_MANAGER_DB_RESET_CHALLENGE_WORD=media-manager

# Include dynamic discovered tables in db-reset plan (destructive).
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Safety note: may truncate additional non-protected tables.
# Example: false
MEDIA_MANAGER_DB_RESET_INCLUDE_DYNAMIC=false

# Enable admin benchmark queueing and worker execution.
# Allowed truthy values: 1, true, yes, on
# Default in code: false
# Safety note: benchmark execution is additionally gated to MEDIA_MANAGER_ENV=dev|test.
# Example: false
MEDIA_MANAGER_BENCHMARKS_ENABLED=false

# Maximum synthetic row count accepted by benchmark queue requests.
# Format: integer > 0
# Default in code: 10000
# Example: 10000
MEDIA_MANAGER_BENCHMARK_MAX_ITEMS=10000

# Benchmark worker poll interval in seconds.
# Format: float > 0
# Default in code: 2.0
# Example: 2.0
MEDIA_MANAGER_BENCHMARK_POLL_INTERVAL_SECONDS=2.0

# Time in seconds before an in-flight benchmark run is marked failed as abandoned by the worker.
# Format: float > 0
# Default in code: 900
# Safety note: this is a failure boundary, not an automatic retry timer.
# Example: 900
MEDIA_MANAGER_BENCHMARK_STALE_AFTER_SECONDS=900

# Benchmark worker mode. Use `forever` for normal operation or `once` for a single polling pass.
# Allowed: forever, once
# Default in code: forever
# Example: forever
MEDIA_MANAGER_BENCHMARK_WORKER_MODE=forever
